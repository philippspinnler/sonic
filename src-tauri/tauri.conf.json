{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sonic",
  "version": "0.1.0",
  "identifier": "com.sonic.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Sonic", "width": 1200, "height": 800 }],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
